{
  "scopeName": "source.ternet",
  "name": "Ternet",
  "fileTypes": ["trn"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#decorators" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "match": "//.*$", "name": "comment.line.double-slash.ternet" },
        { "begin": "/\\*", "end": "\\*/", "name": "comment.block.ternet" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.ternet",
          "patterns": [
            { "match": "\\\\.", "name": "constant.character.escape.ternet" }
          ]
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.ternet",
          "patterns": [
            { "match": "\\\\.", "name": "constant.character.escape.ternet" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b(?:0[xX][0-9A-Fa-f]+|0[bB][01]+|0[oO][0-7]+|[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)\\b",
          "name": "constant.numeric.ternet"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(enum|class|struct|trait|interface)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.declaration.ternet" },
            "2": { "name": "entity.name.type.ternet" }
          }
        },
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.ternet" },
            "2": { "name": "entity.name.function.ternet" }
          }
        },
        {
          "match": "\\b(let|mut|const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.ternet" },
            "2": { "name": "variable.other.ternet" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(?:let|mut|const|fn|return|if|elif|else|while|for|in|break|continue|match|case|import|from|as|export|public|private|protected|struct|class|enum|trait|interface|impl|implements|extends|virtual|override|abstract|final|static|this|super|async|await|spawn|task|channel|throw|try|catch|finally|own|borrow|move|ref|unsafe|namespace|package|generic|where|typeof|is|with|yield|lambda|synchronized|throws|instanceof|volatile|constexpr|macro|attribute|union|extern|auto)\\b",
          "name": "keyword.control.ternet"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(?:int|uint|int8|int16|int32|int64|uint8|uint16|uint32|uint64|float|float32|float64|str|string|String|bool|char|byte|size|duration|void|never|Option|Result|List|Map|Array|Tuple)\\b",
          "name": "storage.type.ternet"
        },
        {
          "match": "\\b[A-Z][A-Za-z0-9_]*(?=\\s*(?:<|\\(|\\[))",
          "name": "entity.name.type.ternet"
        }
      ]
    },
    "constants": {
      "patterns": [
        { "match": "\\b(?:true|false|null)\\b", "name": "constant.language.ternet" }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(?:tnprint|print|input|input_int|input_float|input_bool|len|range|some|none|ok|err)\\b",
          "name": "support.function.ternet"
        },
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()",
          "name": "entity.name.function.ternet"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "match": "@[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*",
          "name": "entity.name.tag.ternet"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "===|!==|==|!=|>=|<=|&&|\\|\\||=>|->|\\?\\?|\\?\\.|\\.\\.|::|[+*/%<>=!&|?-]",
          "name": "keyword.operator.ternet"
        }
      ]
    }
  }
}
