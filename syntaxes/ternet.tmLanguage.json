{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ternet",
  "scopeName": "source.ternet",
  "fileTypes": ["trn"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#attributes" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#classes" },
    { "include": "#functions" },
    { "include": "#builtins" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ternet",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ternet",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ternet",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ternet",
              "match": "\\\\(?:n|r|t|\"|\\)"
            },
            {
              "name": "variable.other.interpolation.ternet",
              "match": "\\$\\{[^}]+\\}"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.ternet",
          "match": "\\b0[xX][0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.binary.ternet",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.float.ternet",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.ternet",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "constant.numeric.size.ternet",
          "match": "\\b[0-9]+(?:\\.[0-9]+)?(?:B|KB|MB|GB|TB|PB)\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "entity.name.tag.ternet",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ternet",
          "match": "\\b(?:if|elif|else|match|for|while|return|break|continue|throw|try|catch|finally)\\b"
        },
        {
          "name": "keyword.declaration.ternet",
          "match": "\\b(?:let|mut|const|comptime|fn|class|interface|trait|impl|enum|type|import|from|as|extends|implements|public|private|protected|override|init)\\b"
        },
        {
          "name": "keyword.operator.word.ternet",
          "match": "\\b(?:async|await|in|is|and|or|not)\\b"
        },
        {
          "name": "keyword.other.ternet",
          "match": "\\b(?:webfile|safe|guard|pipe|defer|watch|task|derive|auto)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.ternet",
          "match": "\\b(?:true|false|null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.ternet",
          "match": "\\b(?:bool|char|byte|int|uint|int8|int16|int32|int64|uint8|uint16|uint32|uint64|float32|float64|float|str|string|void|never|size|duration)\\b"
        },
        {
          "name": "support.type.ternet",
          "match": "\\b(?:Option|Result|Error|Array|Map|Set|String|File|Response|Request)\\b"
        }
      ]
    },
    "classes": {
      "patterns": [
        {
          "name": "entity.name.type.class.ternet",
          "match": "(?<=\\bclass\\s)[A-Z][A-Za-z0-9_]*"
        },
        {
          "name": "entity.name.type.interface.ternet",
          "match": "(?<=\\binterface\\s)[A-Z][A-Za-z0-9_]*"
        },
        {
          "name": "entity.name.type.enum.ternet",
          "match": "(?<=\\benum\\s)[A-Z][A-Za-z0-9_]*"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.definition.ternet",
          "match": "(?<=\\bfn\\s)[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "entity.name.function.call.ternet",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.ternet",
          "match": "\\b(?:tnprint|print|len|range|web_write)\\b"
        },
        {
          "name": "variable.language.ternet",
          "match": "\\b(?:self|this)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.ternet",
          "match": "===|!==|==|!=|>=|<=|=>|->|&&|\\|\\||\\?\\?|\\?\\.|\\+\\+|--|\\+=|-=|\\*=|/=|%=|[+*/%<>=!&|?:-]"
        }
      ]
    }
  }
}
