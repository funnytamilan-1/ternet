{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ternet",
  "scopeName": "source.ternet",
  "fileTypes": ["trn"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.ternet", "match": "//.*$" },
        { "name": "comment.block.ternet", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ternet",
          "begin": """,
          "end": """,
          "patterns": [
            { "name": "constant.character.escape.ternet", "match": "\\\\[nrt"\\\\]" },
            { "name": "variable.other.interpolation.ternet", "match": "\\$\\{[^}]+\\}" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.ternet", "match": "\\b(?:0[xX][0-9A-Fa-f]+|0[bB][01]+|[0-9]+(?:\\.[0-9]+)?)\\b" },
        { "name": "constant.numeric.size.ternet", "match": "\\b[0-9]+(?:\\.[0-9]+)?(?:B|KB|MB|GB|TB|PB)\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ternet",
          "match": "\\b(?:if|elif|else|match|for|while|return|break|continue|throw|try|catch|finally)\\b"
        },
        {
          "name": "keyword.declaration.ternet",
          "match": "\\b(?:let|mut|const|comptime|fn|class|interface|trait|impl|enum|type|import|from|as|extends|implements|public|private|protected|override|init)\\b"
        },
        {
          "name": "storage.type.ternet",
          "match": "\\b(?:bool|char|byte|int|uint|int8|int16|int32|int64|uint8|uint16|uint32|uint64|float32|float64|str|void|never|size|duration)\\b"
        },
        {
          "name": "keyword.operator.ternet",
          "match": "\\b(?:async|await|in|as)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.ternet", "match": "\\b(?:true|false|null)\\b" },
        { "name": "support.type.ternet", "match": "\\b(?:Option|Result|Error)\\b" }
      ]
    },
    "builtins": {
      "patterns": [
        { "name": "support.function.builtin.ternet", "match": "\\b(?:tnprint|print|len|range)\\b" },
        { "name": "entity.name.function.ternet", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.ternet", "match": "===|!==|==|!=|>=|<=|&&|\\|\\||=>|\\?\\?|\\?\\.|[+*/%<>=!&|?-]" }
      ]
    }
  }
}
