{"$schema":"https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json","name":"Ternet","scopeName":"source.ternet","patterns":[{"include":"#comments"},{"include":"#strings"},{"include":"#numbers"},{"include":"#keywords"},{"include":"#types"},{"include":"#constants"},{"include":"#functions"},{"include":"#operators"}],"repository":{"comments":{"patterns":[{"name":"comment.line.double-slash.ternet","match":"//.*$"},{"name":"comment.block.ternet","begin":"/\\*","end":"\\*/"}]},"strings":{"patterns":[{"name":"string.quoted.double.ternet","begin":"\"","end":"\"","patterns":[{"match":"\\\\.","name":"constant.character.escape.ternet"}]}]},"numbers":{"patterns":[{"name":"constant.numeric.ternet","match":"\\b(?:0[xX][0-9a-fA-F]+|0[bB][01]+|[0-9]+(?:\\.[0-9]+)?)\\b"}]},"keywords":{"patterns":[{"name":"keyword.control.ternet","match":"\\b(?:if|elif|else|while|for|in|break|continue|return|throw|try|catch|finally|match|import|from|as|async|await|webfile)\\b|\\b(?:let|mut|const|fn|lit|class|struct|trait|impl|enum|interface|extends|implements)\\b"}]},"types":{"patterns":[{"name":"storage.type.ternet","match":"\\b(?:int|str|float|bool|size|void)\\b"}]},"constants":{"patterns":[{"name":"constant.language.ternet","match":"\\b(?:true|false|null)\\b"}]},"functions":{"patterns":[{"name":"entity.name.function.ternet","match":"\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"}]},"operators":{"patterns":[{"name":"keyword.operator.ternet","match":"==|!=|<=|>=|&&|\\|\\||\\.\\.|=>|[+*/%<>=!-]"}]}}}